using System.Net;
using System.Net.Http.Headers;
using System.Net.Http.Json;
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.Mvc.Testing;
using Microsoft.Data.Sqlite;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Infrastructure;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.DependencyInjection.Extensions;
using Newtonsoft.Json;
using ToDoAPI_ASPNET.Data;
using ToDoAPI_ASPNET.Models.Config;
using ToDoAPI_ASPNET.Models.Dtos.ToDoItems;
using ToDoAPI_ASPNET.Models.Entities;
using ToDoAPI_ASPNET.Models.Response;
using ToDoAPI_ASPNET.Services.Utils;

namespace ToDoAPI_ASPNET.Tests;

public class ApiPipelineTests
{
    [Fact]
    public async Task ProtectedEndpoint_AcceptsAccessToken()
    {
        var settings = TestSupport.CreateJwtSettings();
        await using var factory = new ApiWebApplicationFactory(settings);
        var user = CreateUser();
        await factory.InitializeDatabaseAsync(user);

        using var client = factory.CreateHttpsClient();
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue(
            "Bearer",
            TokenUtil.GenerateToken(user, settings, Token.TokenType.Access));

        var response = await client.GetAsync("/api/v1/toDoItems");

        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
    }

    [Fact]
    public async Task ProtectedEndpoint_RejectsRefreshToken()
    {
        var settings = TestSupport.CreateJwtSettings();
        await using var factory = new ApiWebApplicationFactory(settings);
        var user = CreateUser();
        await factory.InitializeDatabaseAsync(user);

        using var client = factory.CreateHttpsClient();
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue(
            "Bearer",
            TokenUtil.GenerateToken(user, settings, Token.TokenType.Refresh));

        var response = await client.GetAsync("/api/v1/toDoItems");

        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
    }

    [Fact]
    public async Task CreateAndListTaskResponses_ContainPersistedTaskId()
    {
        var settings = TestSupport.CreateJwtSettings();
        await using var factory = new ApiWebApplicationFactory(settings);
        var user = CreateUser();
        await factory.InitializeDatabaseAsync(user);

        using var client = factory.CreateHttpsClient();
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue(
            "Bearer",
            TokenUtil.GenerateToken(user, settings, Token.TokenType.Access));

        var createResponse = await client.PostAsJsonAsync("/api/v1/toDoItems", new ToDoItemCreateDto
        {
            Title = "Prepare portfolio",
            Description = "Verify task identifiers in API responses",
            DueDate = DateTime.UtcNow.AddDays(2)
        });

        Assert.Equal(HttpStatusCode.Created, createResponse.StatusCode);

        var createdBody = JsonConvert.DeserializeObject<ApiResponse<ToDoItemDto>>(
            await createResponse.Content.ReadAsStringAsync());

        Assert.NotNull(createdBody?.Data);
        Assert.True(createdBody.Data.Id > 0);

        var listResponse = await client.GetAsync("/api/v1/toDoItems");
        Assert.Equal(HttpStatusCode.OK, listResponse.StatusCode);

        var listBody = JsonConvert.DeserializeObject<ApiResponse<IEnumerable<ToDoItemDto>>>(
            await listResponse.Content.ReadAsStringAsync());

        var returnedTask = Assert.Single(listBody?.Data ?? Array.Empty<ToDoItemDto>());
        Assert.Equal(createdBody.Data.Id, returnedTask.Id);
    }

    private static User CreateUser()
    {
        return new User
        {
            Id = 42,
            Email = "pipeline@example.com",
            Username = "pipeline-user",
            FirstName = "Pipeline",
            LastName = "Test",
            Password = "not-used"
        };
    }
}

internal sealed class ApiWebApplicationFactory(JWTSettings jwtSettings)
    : WebApplicationFactory<Program>
{
    private readonly SqliteConnection connection = new("Data Source=:memory:");

    protected override void ConfigureWebHost(IWebHostBuilder builder)
    {
        connection.Open();

        builder.UseEnvironment("Testing");
        builder.ConfigureAppConfiguration((_, configuration) =>
        {
            configuration.AddInMemoryCollection(new Dictionary<string, string?>
            {
                ["ConnectionStrings:DefaultConnection"] =
                    "Server=unused;Database=unused;Integrated Security=true;TrustServerCertificate=true",
                ["JWT:Key"] = jwtSettings.Key,
                ["JWT:Issuer"] = jwtSettings.Issuer,
                ["JWT:Audience"] = jwtSettings.Audience,
                ["JWT:AccessTokenExpiry"] = jwtSettings.AccessTokenExpiry.ToString(),
                ["JWT:RefreshTokenExpiry"] = jwtSettings.RefreshTokenExpiry.ToString(),
                ["Database:ApplyMigrationsOnStartup"] = "false"
            });
        });

        builder.ConfigureServices(services =>
        {
            services.RemoveAll<DataContext>();
            services.RemoveAll<DbContextOptions<DataContext>>();
            services.RemoveAll<IDbContextOptionsConfiguration<DataContext>>();

            services.AddSingleton(connection);
            services.AddDbContext<DataContext>((provider, options) =>
                options.UseSqlite(provider.GetRequiredService<SqliteConnection>()));
        });
    }

    public HttpClient CreateHttpsClient()
    {
        return CreateClient(new WebApplicationFactoryClientOptions
        {
            BaseAddress = new Uri("https://localhost"),
            AllowAutoRedirect = false
        });
    }

    public async Task InitializeDatabaseAsync(User user)
    {
        using var scope = Services.CreateScope();
        var context = scope.ServiceProvider.GetRequiredService<DataContext>();
        await context.Database.EnsureCreatedAsync();

        if (!await context.Users.AnyAsync(existing => existing.Id == user.Id))
        {
            context.Users.Add(user);
            await context.SaveChangesAsync();
        }
    }

    protected override void Dispose(bool disposing)
    {
        base.Dispose(disposing);

        if (disposing)
        {
            connection.Dispose();
        }
    }
}
