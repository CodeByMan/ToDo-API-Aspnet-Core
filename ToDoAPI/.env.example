# SQL Server container password. Use a strong value and never commit the real .env file.
MSSQL_SA_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD

# Docker connection string. Keep the password synchronized with MSSQL_SA_PASSWORD.
DEFAULT_CONNECTION=Server=db,1433;Database=ToDoDb;User Id=sa;Password=CHANGE_ME_WITH_A_STRONG_PASSWORD;TrustServerCertificate=True;Encrypt=False

# JWT settings. JWT_SECRET must be Base64Url encoded and decode to at least 32 bytes.
JWT_SECRET=REPLACE_WITH_A_BASE64URL_ENCODED_32_BYTE_OR_LONGER_SECRET
JWT_ISSUER=ToDoAPI
JWT_AUDIENCE=ToDoAPI.Client
JWT_ACCESS_TOKEN_EXPIRY=1
JWT_REFRESH_TOKEN_EXPIRY=30

# CORS and local Docker migration behavior.
CORS_ALLOWED_ORIGIN=http://localhost:3000
APPLY_MIGRATIONS_ON_STARTUP=true
